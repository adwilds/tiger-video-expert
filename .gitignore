# ---------------------------------------------------------------- 依赖
# 430MB，克隆后按 README「安装」重建（python -m venv .venv + pip install 那几个包）
.venv/

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---------------------------------------------------------------- 媒体素材
# 音频/视频是本地生成的演示素材（edge-tts + ffmpeg 合成），体积大且可重建，
# 不进版本库。JSON / SRT / MD 这些「文本产物」照常入库，逻辑和预期结果都在里面。
*.wav
*.mp4
*.mov
*.mkv
*.mp3
*.m4a
*.flac

# ---------------------------------------------------------------- 本地临时与备份
.backup/
.tmp-tts/
.tmp-*

# ---------------------------------------------------------------- 生成物
# 工作台是数据渲染出来的，改了数据就会变；需要时跑 .\run.cmd board 重新生成。
老虎AI爆款·内容专家.html

# 开发过程中的界面截图，未被文档引用
v1.png
v2.png

# 打包产物
*.zip

# ---------------------------------------------------------------- Obsidian 本机状态
# app.json / templates.json 是 vault 配置，入库；
# workspace.json 记录窗口布局和当前打开的文件，换机器就失效，不入库。
知识库/.obsidian/workspace.json
知识库/.obsidian/workspace-mobile.json
知识库/.obsidian/cache/
知识库/.obsidian/plugins/*/data.json

# ---------------------------------------------------------------- 工具会话数据
.workbuddy/

# ---------------------------------------------------------------- 账号级本地数据
# 身份卡是你的定位，情报库是你的选题线索，都不该进公开仓库。
# 模板由 profile init / intel fetch 首次运行时自动生成，不需要入库。
profile.json
身份卡.md
intel-sources.json
intel/

# ---------------------------------------------------------------- 系统
Thumbs.db
desktop.ini
.DS_Store
